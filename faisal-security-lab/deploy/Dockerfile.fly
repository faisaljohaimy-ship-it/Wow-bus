# Single-image deploy (API + UI + in-process worker + security tools) for Fly.io
# or any container host. Listens on 0.0.0.0:8080.
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl tar && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/install-tools.sh ./scripts/install-tools.sh
# Install the real security tools (pinned). Trivy is optional and tolerated.
RUN bash scripts/install-tools.sh /usr/local/bin /opt/sectools-venv || true

COPY app ./app
COPY web ./web
COPY data ./data

ENV FSL_BIND_HOST=0.0.0.0 \
    FSL_PORT=8080 \
    FSL_DATA_DIR=/data \
    PATH="/usr/local/bin:${PATH}"
EXPOSE 8080

# Unprivileged service user. /data is created and owned before anything else
# touches it, so its ownership does not depend on the image builder. No VOLUME
# instruction: hosts attach storage explicitly (fly.toml mount, Render disk).
RUN groupadd -g 10001 fsl && useradd -m -u 10001 -g 10001 fsl \
    && mkdir -p /data && chown fsl:fsl /data
COPY deploy/entrypoint.sh /usr/local/bin/fsl-entrypoint
RUN chmod 755 /usr/local/bin/fsl-entrypoint

# The entrypoint fixes ownership of a host-mounted /data, then drops to the
# unprivileged user before starting the server (see deploy/entrypoint.sh).
ENTRYPOINT ["/usr/local/bin/fsl-entrypoint"]
# In-process workers are enabled (FSL_NO_WORKER is unset).
CMD ["python3", "-m", "app.server"]
