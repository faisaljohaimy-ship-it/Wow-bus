# Faisal Security Lab: reference of the environment variables the platform reads.
#
# The platform does not load this file. It reads process environment variables
# only, so either
#   - copy this file to .env, edit it, and load it in the shell that starts the
#     server:   set -a; . ./.env; set +a
#   - or set the same names in your host's dashboard (Render, Fly.io, Docker).
#
# Every comment is on its own line above the setting it describes. A setting
# that is commented out is optional and shows an example value. Never commit a
# file that holds a real password or key.

# --- server ---
# Address to listen on. Use 0.0.0.0 only behind a proxy or inside a container.
FSL_BIND_HOST=127.0.0.1
# Port to listen on.
FSL_PORT=8787
# If PORT is set it takes precedence over FSL_PORT. Hosting platforms such as
# Render set PORT themselves; you normally leave it alone.
# PORT=8787
# Directory for the database, the evidence files and the generated secret key.
# A relative path is taken from the directory the server is started in.
FSL_DATA_DIR=./var
# Optional separate locations for the database file and the evidence directory.
# FSL_DB_PATH=./var/faisal-security-lab.db
# FSL_EVIDENCE_DIR=./var/evidence
# Optional other tool catalog file (default: data/tool-catalog.seed.json).
# FSL_SEED_CATALOG=./data/tool-catalog.seed.json

# --- behind a reverse proxy (optional) ---
# By default the connecting address is the client and proxy headers are ignored.
# Set ONE of these, and only when the service cannot be reached except through
# the proxy.
# Header the proxy sets to the visitor's address (CF-Connecting-IP on Render,
# Fly-Client-IP on Fly.io):
# FSL_CLIENT_IP_HEADER=CF-Connecting-IP
# Or the number of proxies that each append to X-Forwarded-For (0 to 10):
# FSL_TRUSTED_PROXY_HOPS=1

# --- identity ---
# Sign-in address of the owner account that the first server start creates.
FSL_OWNER_EMAIL=owner@faisal-security-lab.local
# Owner password, at least 10 characters. It is used only when the account is
# created; changing it later does not change an existing account. If it is unset
# the first server start prints a generated password, shown once, in the log.
# FSL_OWNER_PASSWORD=
# Secret key of the installation. If unset, one is generated and kept in
# <data directory>/.session-secret. This version uses it only to derive the job
# keys of the public demo's scans; sessions do not depend on it.
# FSL_SECRET_KEY=
# Lifetime of a sign-in, in seconds.
FSL_SESSION_TTL=43200

# --- public read-only view (optional; off unless set) ---
# 1 lets visitors READ one demo project without signing in. Every action (scan,
# edit, users, audit, stop) still needs a sign-in.
# FSL_PUBLIC_VIEW=1
# Ceiling on guest requests per minute, all guests together. The default, 240,
# suits a tenth of a CPU.
# FSL_GUEST_REQUESTS_PER_MINUTE=240
# Scanners run once on samples/vulnerable-app for the demo project. Only passive
# source connectors are accepted; anything else is ignored.
# FSL_DEMO_CONNECTORS=bandit,gitleaks,pip_audit

# --- environment / gating ---
# A label for this deployment: lab, staging or prod.
FSL_ENVIRONMENT=lab
# 1 permits connectors that send traffic to the target on scopes whose
# environment is prod.
FSL_ALLOW_ACTIVE_IN_PROD=0

# --- limits ---
# Wall-clock seconds per job.
FSL_JOB_TIMEOUT=900
# CPU seconds per tool process (RLIMIT_CPU).
FSL_JOB_CPU_SECONDS=1200
# Address-space limit per tool process in MB (RLIMIT_AS). 0 means off. It breaks
# Semgrep; limit memory with a container memory limit on the worker instead.
FSL_JOB_AS_MB=0
# Number of worker threads the server starts in its own process. A separate
# worker process (python3 -m app.worker) runs one job at a time and does not
# read this; start more worker processes instead.
FSL_WORKER_CONCURRENCY=2

# --- workers ---
# 1 on the API host when workers run as separate processes: the server then
# starts no worker thread of its own.
# FSL_NO_WORKER=1

# --- AI provider (optional) ---
# none, openai-compatible or anthropic. With none, the AI features use built-in
# rules and nothing is sent anywhere.
FSL_AI_PROVIDER=none
# FSL_AI_BASE_URL=
# FSL_AI_MODEL=
# Never commit a real key.
# FSL_AI_API_KEY=
# Upper limit of tokens in one model reply.
# FSL_AI_MAX_TOKENS=4096

# --- connectors ---
# Semgrep rules to use instead of the bundled ones in data/semgrep-rules, for
# example auto or p/ci. Caution: registry rule packs are not part of this
# project, are downloaded by your own Semgrep, and are under Semgrep's own rules
# licence. Check that licence before using them, especially on a public
# instance.
# FSL_SEMGREP_CONFIG=p/ci

# --- container image only (read by deploy/entrypoint.sh) ---
# 1 makes the container refuse to start when it cannot drop root privileges.
# FSL_REQUIRE_NONROOT=1

# --- standard variables passed on to the scanners ---
# The scanners are started with a minimal environment. Of the server's own
# environment they receive only PATH and, when set, the variables below.
# HTTP_PROXY is passed on only together with HTTPS_PROXY. SSL_CERT_FILE is also
# used for calls to the AI provider.
# SSL_CERT_FILE=/path/to/ca-bundle.crt
# CURL_CA_BUNDLE=/path/to/ca-bundle.crt
# HTTPS_PROXY=http://proxy.example:3128
# HTTP_PROXY=http://proxy.example:3128
