# Faisal Security Lab — environment configuration (NO SECRETS COMMITTED).
# Copy to .env and adjust. The platform reads these at startup.

# --- server ---
FSL_BIND_HOST=127.0.0.1
FSL_PORT=8787
FSL_DATA_DIR=./var                 # db, evidence, session secret live here
# FSL_DB_PATH=./var/faisal-security-lab.db
# FSL_EVIDENCE_DIR=./var/evidence

# --- identity ---
FSL_OWNER_EMAIL=owner@faisal-security-lab.local
# FSL_OWNER_PASSWORD=                # if unset, a one-time password is printed at first boot
# FSL_SECRET_KEY=                    # session signing key; auto-generated to var/.session-secret if unset
FSL_SESSION_TTL=43200               # seconds

# --- environment / gating ---
FSL_ENVIRONMENT=lab                 # lab|staging|prod (a deployment hint)
FSL_ALLOW_ACTIVE_IN_PROD=0          # 1 permits active connectors against prod-scoped assets

# --- limits ---
FSL_JOB_TIMEOUT=900                 # wall-clock seconds per job
FSL_JOB_CPU_SECONDS=1200            # RLIMIT_CPU per connector subprocess
FSL_JOB_AS_MB=0                     # RLIMIT_AS cap in MB; 0=off (use cgroup --memory on the worker)
FSL_WORKER_CONCURRENCY=2

# --- workers ---
# FSL_NO_WORKER=1                    # set on the API host when workers run as separate processes

# --- AI provider (optional; platform degrades to deterministic fallback if unset) ---
FSL_AI_PROVIDER=none                # none|openai-compatible|anthropic
# FSL_AI_BASE_URL=
# FSL_AI_MODEL=
# FSL_AI_API_KEY=                   # NEVER commit a real key

# --- connectors ---
# FSL_SEMGREP_CONFIG=               # e.g. 'auto' or 'p/ci' (needs registry egress); default: bundled offline rules
