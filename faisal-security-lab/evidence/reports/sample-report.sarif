            {
              "id": "python-requests-verify-false",
              "shortDescription": {
                "text": "Disabling TLS verification (verify=False) allows machine-in-the-middle attacks. Keep certificate verification enabled."
              },
              "properties": {
                "cwe": "CWE-295: Improper Certificate Validation"
              }
            },
            {
              "id": "python-subprocess-shell-true",
              "shortDescription": {
                "text": "subprocess call with shell=True can lead to OS command injection when any argument is attacker-influenced. Pass an argum"
              },
              "properties": {
                "cwe": "CWE-78: Improper Neutralization of Special Elements used in an OS Command"
              }
            },
            {
              "id": "python-dangerous-eval-exec",
              "shortDescription": {
                "text": "Use of eval()/exec() on dynamic input allows arbitrary code execution. Avoid eval/exec; parse data explicitly."
              },
              "properties": {
                "cwe": "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code"
              }
            },
            {
              "id": "python-yaml-unsafe-load",
              "shortDescription": {
                "text": "yaml.load without SafeLoader can instantiate arbitrary Python objects. Use yaml.safe_load()."
              },
              "properties": {
                "cwe": "CWE-502: Deserialization of Untrusted Data"
              }
            },
            {
              "id": "python-weak-hash-md5",
              "shortDescription": {
                "text": "MD5 is cryptographically broken. Use SHA-256 or better for security purposes (not for passwords — use a KDF)."
              },
              "properties": {
                "cwe": "CWE-327: Use of a Broken or Risky Cryptographic Algorithm"
              }
            }
          ]
        }
      },
